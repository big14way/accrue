# ───────── Monad ─────────
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# Deployer / demo actors (testnet only; never reuse on mainnet)
DEPLOYER_PRIVATE_KEY=0x
CLIENT_PRIVATE_KEY=0x
PROVIDER_PRIVATE_KEY=0x
ATTESTOR_PRIVATE_KEY=0x

# Deployment parameters
PAYMENT_TOKEN=0x534b2f3A21130d7a60830c2Df862319e593943A3   # testnet USDC (or a MockUSDC address)
YIELD_VAULT=                                                # empty = deploy MockYieldVault on the token
PROTOCOL_TREASURY=                                          # empty = deployer
CRE_FORWARDER=0xB9F79d863261869B234c481D1f9A7af84AeAd192   # Mock forwarder for `cre workflow simulate --broadcast`
CRE_WORKFLOW_OWNER=                                         # empty = accept any workflow owner
COMMITTEE_MEMBERS=                                          # comma-separated; empty = deployer + attestor
COMMITTEE_THRESHOLD=1
ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
POOL_CAP=1000000000                                         # 1,000 USDC (6 dp)
MOCK_RATE_WAD_PER_BLOCK=862506342                           # 6.8 % APR at 400 ms blocks = live Morpho Steakhouse AUSD APR on Monad mainnet (17 Sep 2026)

# Verification
MONADSCAN_API_KEY=

# Off-chain services
NANSEN_API_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_ENVIO_GRAPHQL=http://localhost:8080/v1/graphql
